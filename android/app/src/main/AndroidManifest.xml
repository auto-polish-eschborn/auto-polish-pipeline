<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Auto-Polish"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden" android:name=".OrderFormActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".OrderDetailActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".OrdersActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".LoginActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".SettingsActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".ProfileActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".DocumentActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden" android:name=".BusinessActivity" android:exported="false" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".PdfActivity" android:exported="false" />
        <activity android:name=".BarcodeActivity" android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ScanResultActivity" android:exported="false" />
        <provider android:name=".SharedFiles" android:authorities="de.autopolish.nativeapp.files" android:exported="false" android:grantUriPermissions="true" />
        <activity android:windowSoftInputMode="adjustResize" android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
